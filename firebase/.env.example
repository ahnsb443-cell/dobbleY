# Cloud Functions non-secret config. Copy to root .env.<actual-project-id>, which Git ignores.
# Web API key is public configuration; this server uses it to call Firebase Authentication.
WEB_API_KEY=YOUR_WEB_API_KEY
# Default production origin is https://<project-id>.web.app
# PUBLIC_ORIGIN=https://your-custom-domain.example
# SETUP_TOKEN is NOT stored here; use Firebase Secret Manager.
