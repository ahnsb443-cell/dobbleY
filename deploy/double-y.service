[Unit]
Description=Double Y Payroll
After=network.target

[Service]
Type=simple
User=doubley
Group=doubley
WorkingDirectory=/opt/double-y
EnvironmentFile=/etc/double-y.env
ExecStart=/usr/bin/node /opt/double-y/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/double-y /var/backups/double-y

[Install]
WantedBy=multi-user.target
