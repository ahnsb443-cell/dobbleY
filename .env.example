# Copy securely to .env or a protected EnvironmentFile; never commit real values.
NODE_ENV=production
PUBLIC_ORIGIN=https://payroll.example.com
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/double-y
BACKUP_DIR=/var/backups/double-y
